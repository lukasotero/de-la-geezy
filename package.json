{
  "name": "de-la-geezy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:responsive": "playwright test e2e/responsive.spec.ts",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "doctor:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "doctor": "npm run doctor:clean && react-doctor . --verbose --no-dead-code --offline -y && knip",
    "doctor:react": "npm run doctor:clean && react-doctor . --verbose --no-dead-code --offline -y",
    "doctor:dead-code": "knip",
    "check": "npm run typecheck && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "lucide-react": "^0.548.0",
    "motion": "^14.9.1",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.7",
    "knip": "^6.0.0",
    "react-doctor": "^0.9.12",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
